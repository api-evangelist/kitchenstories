{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kitchen Stories Internal Articles Admin Stats API",
    "version": "3"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Stats",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get stats on current state of UGC Recipes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.kitchenstories.io/api/stats/community-recipes/",
            "params": [
              {
                "name": "language",
                "value": "",
                "type": "query",
                "description": "Filter by language (en, de, zh only)"
              }
            ]
          },
          "docs": "Get stats on current state of UGC Recipes"
        }
      ]
    }
  ],
  "bundled": true
}